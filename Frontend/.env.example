# Set to "false" to talk to the real backend through the gateway
VITE_USE_MOCK_API=false

# API gateway
VITE_API_BASE_URL=http://localhost:8080

# Keycloak (public client, PKCE; add http://localhost:5173/* as redirect URI and web origin)
VITE_KEYCLOAK_URL=http://localhost:8084
VITE_KEYCLOAK_REALM=jobkaki-oauth2
VITE_KEYCLOAK_CLIENT_ID=jobkaki-frontend

